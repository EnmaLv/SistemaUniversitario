  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint
}

Table user {
  id_use bigint [primary key, increment]
  per_id bigint [not null, unique]
  id_perfil bigint [not null]
  email_use varchar(255) [unique]
  username_use varchar(100) [not null, unique]
  password_use varchar(255) [not null]
  master_key_use text
  security_questions_use jsonb
  intentos_fallidos_use smallint [not null, default: 0]
  intentos_llave_fallidos_use smallint [not null, default: 0]
  bloqueado_hasta_use timestamptz
  bloqueos_temporales_use smallint [not null, default: 0]
  ventana_bloqueos_desde_use timestamptz
  bloqueado_use boolean [not null, default: false]
  bloqueado_en_use timestamptz
  motivo_bloqueo_use varchar(100)
  ultimo_login_use timestamptz
  ultimo_login_ip_use varchar(45)
  remember_token_use varchar(100)
  ultima_actividad_chat_use timestamptz
  chat_activo_use_id bigint
  infracciones_reset_at_use timestamptz
  debe_cambiar_password_use boolean [not null, default: false]
  password_cambiado_en_use timestamptz
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint
}

Table usuario_modulo {
  id_umo bigint [primary key, increment]
  use_id bigint [not null]
  mod_id bigint [not null]
  asignado_por_use_id bigint
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint

  indexes {
    (use_id, mod_id) [unique]
  }
}

Table usuario_permiso {
  id_usp bigint [primary key, increment]
  use_id bigint [not null]
  pmi_id bigint [not null]
  tipo_usp varchar(10) [not null, default: 'grant']
  fecha_inicio_usp date
  fecha_fin_usp date
  asignado_por_use_id bigint
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint

  indexes {
    (use_id, pmi_id) [unique]
  }
}

Table usuario_rol {
  id_usr bigint [primary key, increment]
  rol_id bigint [not null]
  use_id bigint [not null]
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint

  indexes {
    (rol_id, use_id) [unique]
  }
}

Table vehiculo_transporte {
  id_vtr bigint [primary key, increment]
  placa_vtr varchar(20) [not null, unique]
  anio_vtr integer [not null]
  color_vtr varchar(50)
  peso_vtr numeric(8,2) [not null, default: 0.00]
  capacidad_pasajeros_vtr integer [not null, default: 0]
  cantidad_cilindros_vtr integer [not null, default: 1]
  capacidad_tanque_litros_vtr numeric(8,2) [not null, default: 0.00]
  nivel_combustible_actual_vtr numeric(8,2) [not null, default: 0.00]
  consumo_urbano_vtr numeric(6,3) [not null, default: 0.000]
  consumo_carretera_vtr numeric(6,3) [not null, default: 0.000]
  consumo_ralenti_vtr numeric(6,3) [not null, default: 0.000]
  km_actual_vtr numeric(10,2) [not null, default: 0.00]
  km_proximo_mantenimiento_vtr numeric(10,2) [not null, default: 0.00]
  estado_operativo_vtr varchar(20) [not null, default: 'disponible']
  mov_id bigint [not null]
  tcb_id bigint [not null]
  sed_id bigint [not null]
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint
}

Table viaje_transporte {
  id_vjt bigint [primary key, increment]
  turno_vjt varchar(100)
  firebase_id_vjt varchar(100)
  fecha_inicio_vjt timestamptz
  km_inicio_vjt numeric(10,2) [not null, default: 0.00]
  km_fin_vjt numeric(10,2) [not null, default: 0.00]
  distancia_km_vjt numeric(8,2) [not null, default: 0.00]
  litros_gastados_vjt numeric(8,2) [not null, default: 0.00]
  total_pasajeros_vjt integer [not null, default: 0]
  hubo_desvio_vjt boolean [not null, default: false]
  motivo_desvio_vjt varchar(255)
  estado_viaje_vjt varchar(20) [not null, default: 'programado']
  vtr_id bigint [not null]
  rtr_id bigint [not null]
  conductor_use_id bigint
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint
}

Table vista {
  id_vis bigint [primary key, increment]
  key_vis varchar(150) [not null, unique]
  nombre_vis varchar(255) [not null]
  descripcion_vis text
  ruta_vis varchar(255)
  icono_vis varchar(100)
  orden_vis integer [not null, default: 0]
  mod_id bigint
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint
}

