// DER adaptado del Sistema de Bienestar Estudiantil (UPTP)
// Generado desde el esquema real tras ejecutar las migraciones (2026-10-21).
// Tipos expresados como en el DER del profesor (PostgreSQL): en MySQL timestamptz = timestamp y jsonb = json.

Table archivos {
  id bigint [primary key, increment]
  info_estudiantes varchar(255) [not null]
  ruta_archivo varchar(255)
  nombre_original varchar(255)
  resumen jsonb
  usuario_id bigint
  fecha date [not null]
  estado varchar(255) [not null]
  created_at timestamptz
  updated_at timestamptz
}

Table avance_sesion {
  id_avs bigint [primary key, increment]
  valor_avs smallint [not null, default: 0]
  nombre_avs varchar(150) [not null]
  descripcion_avs text
  es_sistema_avs boolean [not null, default: false]
  activo_avs boolean [not null, default: true]
  psicologo_use_id bigint
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint
}

Table beneficio_asignado {
  id_bfa bigint [primary key, increment]
  fecha_inicio_bfa date [not null]
  fecha_fin_bfa date
  estado_bfa varchar(30) [not null, default: 'activa']
  motivo_revocacion_bfa text
  sob_id bigint [not null]
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint
}

Table beneficio_estudiantil {
  id_bes bigint [primary key, increment]
  nombre_beneficio_bes varchar(255) [not null]
  descripcion_bes text
  slug_bes varchar(255) [not null]
  cupones_disponibles_bes integer [not null, default: 0]
  cupones_ocupados_bes integer [not null, default: 0]
  tbe_id bigint
  created_at timestamptz
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint
}

Table bitacora_sistema {
  id_bis bigint [primary key, increment]
  modulo_bis varchar(100)
  tipo_evento_bis varchar(100) [not null]
  tabla_afectada_bis varchar(100)
  nombre_usuario_bis varchar(255)
  datos_anteriores_bis jsonb
  datos_nuevos_bis jsonb
  direccion_ip_bis varchar(45)
  navegador_bis varchar(255)
  sistema_operativo_bis varchar(100)
  observacion_bis text
  use_id bigint
  registro_id_bis bigint
  metodo_http_bis varchar(10)
  ruta_bis varchar(191)
  url_bis varchar(2048)
  codigo_respuesta_bis smallint
  nivel_bis varchar(20) [not null, default: 'info']
  session_id_bis varchar(64)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  status_id bigint [not null, default: 1]
  deleted_at timestamptz
  created_id bigint
  updated_id bigint
}

