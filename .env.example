APP_NAME=GestionUniversitaria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysqlbienestraestudiantil
DB_PORT=3306
DB_DATABASE=bienestraestudiantil
DB_USERNAME=admin
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=20
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="BienestarEstudiantil@uptp.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_EXPIRE_ON_CLOSE=false

SEGURIDAD_MAX_INTENTOS_LOGIN=3
SEGURIDAD_MINUTOS_BLOQUEO_TEMPORAL=5
SEGURIDAD_BLOQUEOS_PARA_PERMANENTE=3
SEGURIDAD_HORAS_VENTANA_BLOQUEOS=24
SEGURIDAD_MAX_INTENTOS_LLAVE=3
SEGURIDAD_MAX_INTENTOS_RECUPERACION=3
SEGURIDAD_MAX_CONSULTAS_RECUPERACION_IP=10
SEGURIDAD_MINUTOS_VALIDEZ_RECUPERACION=10
SEGURIDAD_MAX_ACCESOS_DENEGADOS=10
SEGURIDAD_MINUTOS_VENTANA_ACCESOS=10
SEGURIDAD_MINUTOS_INACTIVIDAD=15
SEGURIDAD_SEGUNDOS_AVISO_INACTIVIDAD=60
SEGURIDAD_BITACORA_HABILITADA=true
SEGURIDAD_BITACORA_PETICIONES=true
SEGURIDAD_BITACORA_MODELOS=true
SEGURIDAD_CABECERAS=true
SEGURIDAD_PROXIES_CONFIABLES=*
